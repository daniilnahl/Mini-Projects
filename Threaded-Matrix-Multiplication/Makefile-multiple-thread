CC = gcc
CFLAGS = -Wall -Wextra -Werror -std=c11 -g -O2 -pthread -D_POSIX_C_SOURCE=200809L
TARGET = matrix_multi

SRCS = multi-thread-mm.c
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $@

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

run: $(TARGET)
	./$(TARGET)

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all run clean